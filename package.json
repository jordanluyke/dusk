{
    "name": "dusk",
    "version": "1.0.0",
    "description": "",
    "type": "module",
    "scripts": {
        "build": "node bin/build.js",
        "start": "node target/main.js",
        "test": "npm run build && NODE_OPTIONS=\"--experimental-vm-modules\" jest",
        "test:watch": "npm run test -- --watch",
        "test:coverage": "npm run test -- --coverage"
    },
    "author": "Jordan Luyke",
    "dependencies": {
        "axios": "1.19.0",
        "dotenv": "17.4.2",
        "jest": "30.4.2",
        "reflect-metadata": "0.2.2",
        "suncalc": "2.0.1",
        "tsyringe": "4.10.0",
        "typescript": "7.0.2"
    },
    "devDependencies": {
        "@types/node": "26.1.1",
        "@types/suncalc": "1.9.2"
    },
    "jest": {
        "testEnvironment": "node",
        "testMatch": [
            "<rootDir>/test/**/*.test.js"
        ]
    }
}
